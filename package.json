{
  "name": "zotero-note-template-vars",
  "version": "1.0.0",
  "type": "module",
  "description": "Adds citationKey, pageLabel, pdfLink, and other item/annotation variables to Zotero's annotation note templates.",
  "author": "Daniel Eder <danieleder@outlook.at>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/daniel-eder/zotero-note-template-variables.git"
  },
  "scripts": {
    "start": "zotero-plugin serve",
    "build": "zotero-plugin build",
    "release": "zotero-plugin release",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "config": {
    "addonName": "Note Template Variables",
    "addonID": "note-template-vars@danieleder.at",
    "addonRef": "noteTemplateVars",
    "addonInstance": "NoteTemplateVars",
    "prefsPrefix": "extensions.noteTemplateVars"
  },
  "devDependencies": {
    "typescript": "^7.0.2",
    "vitest": "^5.1.1",
    "zotero-plugin-scaffold": "^0.9.4",
    "zotero-types": "^4.1.3"
  }
}
